# ZUSÄTZLICHE HEURISTIKEN – KERN 2A (RAM-Drift)
# ==============================================================================

# Schneller RAM-Anstieg über mehrere Zyklen
prev_ram = 0
ram_rise_count = 0

while true; do
    RAM_USAGE=$(free | awk '/Mem:/ {print int($3/$2 * 100)}')
    
    if [ "$prev_ram" -gt 0 ] && [ "$RAM_USAGE" -gt "$prev_ram" ]; then
        ram_rise_count=$((ram_rise_count + 1))
        if [ "$ram_rise_count" -ge 5 ] && [ "$RAM_USAGE" -gt 80 ]; then
            echo "[$(date)] [!!!] ANOMALIE: Schneller RAM-Anstieg über 5 Zyklen ($RAM_USAGE%)" >> "$LOG_FILE"
            trigger_veto "RAPID RAM RISE DETECTED"
        fi
    else
        ram_rise_count=0
    fi
    prev_ram=$RAM_USAGE
    
    sleep 3
done

# ==============================================================================
# ZUSÄTZLICHE HEURISTIKEN – KERN 1 (Netzwerk)
# ==============================================================================

# SYN-Flood / Port-Scan Erkennung (kurze Zeitfenster)
# Zählt SYN-Pakete ohne entsprechenden ACK in einem 5-Sekunden-Fenster
syn_count = 0
syn_window_start = systime()

if ($0 ~ /Flags \[S\]/ && $0 !~ /Flags \[S\.\]/) {
    syn_count++
    if (systime() - syn_window_start >= 5) {
        if (syn_count > 200) {
            cmd_log = "echo \"[" systime() "] [!!!] ANOMALIE: Hohe SYN-Rate ohne ACK (" syn_count ")\" >> " logf
            system(cmd_log)
            system("ip link set " if1 " down; ip link set " if2 " down")
            exit
        }
        syn_count = 0
        syn_window_start = systime()
    }
}

# Plötzliche Änderung der durchschnittlichen Paketgröße
# Einfache laufende Statistik (letzte 10 Pakete)
packet_size_sum = 0
packet_count = 0
if (NF > 0) {
    # Annahme: Länge steht in einem der Felder; anpassen falls nötig
    size = length($0)
    packet_size_sum += size
    packet_count++
    if (packet_count >= 10) {
        avg = packet_size_sum / packet_count
        if (avg > 1200 || avg < 40) {
            cmd_log = "echo \"[" systime() "] [!!!] ANOMALIE: Ungewöhnliche durchschnittliche Paketgröße (" avg ")\" >> " logf
            system(cmd_log)
        }
        packet_size_sum = 0
        packet_count = 0
    }
}

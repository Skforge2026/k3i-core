# =============================================================================
# PROJEKT 1: REALTIME PLASMA EVOLUTION & FEEDBACK CONTROL
# SYSTEM: HARD-REALTIME ENVIRONMENT (CORES 2-15 ISOLATED)
# LANGUAGE: JULIA JIT-COMPILER
# =============================================================================
using Printf

function zünde_plasma_experiment()
    println("=== SCHICHT-NULL: PARTIKEL-WANDKONTAKT-MESSUNG ZÜNDUNG ===")
    
    N = 300
    dt = 0.005
    schritte = 400
    D = 0.35              
    
    dichte = zeros(N, N)
    neu_dichte = zeros(N, N)
    mitte = div(N, 2)
    
    for x in 1:N, y in 1:N
        distanz = sqrt((x-mitte)^2 + (y-mitte)^2)
        if distanz < 40.0
            dichte[x, y] = 100.0 * cos(distanz / 40.0 * pi / 2)
        end
    end
    
    println("-> Plasma geladen. Messsensoren an der Reaktorwand sind scharfgeschaltet.")
    println("| Schritt | Wand-Einschläge (Teilchen) | Energie-Peak (MJoule) | Kern-Rest | Status-Wand |")
    println("| :---:   | :---:                      | :---:                | :---:     | :---        |")
    
    for t in 1:schritte
        stoerung_x = 0.2 * exp(t * 0.028)
        
        Threads.@threads for x in 2:(N-1)
            for y in 2:(N-1)
                vx = -(y - mitte) / N * 4.0
                vy =  (x - mitte) / N * 4.0 + stoerung_x
                
                grad_x = (dichte[x+1, y] - dichte[x-1, y]) / 2.0
                grad_y = (dichte[x, y+1] - dichte[x, y-1]) / 2.0
                advektion = vx * grad_x + vy * grad_y
                laplace = dichte[x+1, y] + dichte[x-1, y] + dichte[x, y+1] + dichte[x, y-1] - 4.0 * dichte[x, y]
                
                neu_dichte[x, y] = dichte[x, y] + dt * (D * laplace - advektion)
            end
        end
        
        wand_einschlaege = 0.0
        for i in 1:N
            wand_einschlaege += abs(neu_dichte[2, i]) + abs(neu_dichte[N-1, i])
            wand_einschlaege += abs(neu_dichte[i, 2]) + abs(neu_dichte[i, N-1])
        end
        
        dichte .= neu_dichte
        
        if t % 40 == 0
            zentrum_d = dichte[mitte, mitte]
            energie_peak = wand_einschlaege * 1.602e-19 * 1e6 
            status = wand_einschlaege < 1.0 ? "Vakuum rein" : (zentrum_d > 10.0 ? "WANDKONTAKT" : "REAKTOR-ABRISS")
            
            @printf("| %-7d | %-26.2e | %-20.2e | %-9.2f | %-12s |\n", t, wand_einschlaege, energie_peak, zentrum_d, status)
        end
    end
    println("=== STRÖMUNGSMESSUNG BEENDET | ZÄHLWERK ARRETIERT ===")
end

zünde_plasma_experiment()



MODULE_LICENSE("GPL");
MODULE_AUTHOR("SK-Forge UG");
MODULE_DESCRIPTION("K3I Stöchiometrisches Tritium-Blanket-Monitoring");

// Physikalische Adressen für die Sensor- und Ventil-Matrix der Blanket-Schnittstelle
#define RECTOR_BLANKET_BASE     0x0FED8100
#define BLANKET_SET_OFFSET      0x00  // Ventil offen / Normalbetrieb
#define BLANKET_CLEAR_OFFSET    0x04  // Veto-Abriss / Not-Schließung
#define PROC_BLANKET_NAME       "k3i_blanket_status"

// Unbestechlicher Latenz-Schwellenwert im Takt des Quarzes
#define NEUTRON_FLUX_THRESHOLD  4200 

static void __iomem *blanket_map;
static struct task_struct *blanket_thread;
static uint64_t blanket_last_jitter = 0;

/*
 * Serialisiertes Auslesen über rdtscp fängt die exakte Kern-ID ab
 * und blockiert jede Out-of-Order-Pipeline-Spekulation der CPU
 */
static inline uint64_t read_rdtscp_blanket(void) {
    uint32_t lo, hi;
    __asm__ __volatile__ ("rdtscp" : "=a" (lo), "=d" (hi) :: "rcx");
    return ((uint64_t)hi << 32) | lo;
}

/*
 * Der blockierende Echtzeit-Wächter auf Kern 3
 * Arbeitet ohne administrative Software-Bremsen im reinen Polling-Modus
 */
static int kthread_blanket_monitor(void *data) {
    uint64_t start_cycles, end_cycles, delta;

    pr_info("K3I-Blanket: Monitoring für Lithium-Neutronen-Symmetrie aktiv (Core 3).\n");

    while (!kthread_should_stop()) {
        start_cycles = read_rdtscp_blanket();
        
        // --- Sch LAYER ZERO: Direktes Einlesen des Sensor-Arrays am Lithium-Blanket ---
        // (Wird im Live-Betrieb an den dedizierten Hardware-Interrupt gekoppelt)
        __asm__ __volatile__ ("nop"); 

        end_cycles = read_rdtscp_blanket();
        delta = end_cycles - start_cycles;
        blanket_last_jitter = delta; // Wert für die ProcFS-Überwachung sichern

        if (unlikely(delta > NEUTRON_FLUX_THRESHOLD)) {
            // Symmetriebruch detektiert: Injektor-Ventil SOFORT stromlos schalten!
            iowrite32(0x00000001, blanket_map + BLANKET_CLEAR_OFFSET);
            pr_emerg("K3I-BLANKET-ALARM: Lokale Neutronen-Überlastung! Jitter: %llu Zyklen. Fluss gedrosselt!\n", delta);
            break; 
        }

        // Optimierung für isolcpus=3: Verhindert CPU-Verstopfung im Testbetrieb
        if (!IS_ENABLED(CONFIG_HIGHPTE)) {
            __asm__ __volatile__ ("pause");
        }
    }
    return 0;
}

// ProcFS Handlers für die Live-Visualisierung im Monitoring
static int k3i_blanket_show(struct seq_file *m, void *v) {
    seq_printf(m, "%llu\n", blanket_last_jitter);
    return 0;
}

static int k3i_blanket_open(struct inode *inode, struct file *file) {
    return single_open(file, k3i_blanket_show, NULL);
}

static const struct proc_ops k3i_blanket_ops = {
    .proc_open    = k3i_blanket_open,
    .proc_read    = seq_read,
    .proc_lseek   = seq_lseek,
    .proc_release = single_release,
};

static int __init k3i_blanket_init(void) {
    pr_info("K3I-Core: Lade Blanket-Überwachungsmodul.\n");
    
    blanket_map = ioremap(RECTOR_BLANKET_BASE, 0x100);
    if (!blanket_map) {
        return -ENOMEM;
    }
    
    // Initialisierung: Ventil auf HIGH (+3.3V) setzen, Fluss freigeben
    iowrite32(0x00000001, blanket_map + BLANKET_SET_OFFSET);
    
    // Erstelle den Proc-Eintrag für dein Python-Skript
    if (!proc_create(PROC_BLANKET_NAME, 0444, NULL, &k3i_blanket_ops)) {
        iounmap(blanket_map);
        return -ENOMEM;
    }
    
    blanket_thread = kthread_run(kthread_blanket_monitor, NULL, "k3i_blanket_watcher");
    if (IS_ERR(blanket_thread)) {
        remove_proc_entry(PROC_BLANKET_NAME, NULL);
        iounmap(blanket_map);
        return PTR_ERR(blanket_thread);
    }
    
    return 0;
}

static void __exit k3i_blanket_exit(void) {
    if (blanket_thread) {
        kthread_stop(blanket_thread);
    }
    remove_proc_entry(PROC_BLANKET_NAME, NULL);
    if (blanket_map) {
        // Sicherer Zustand beim Entladen: Ventil schließen (0V)
        iowrite32(0x00000001, blanket_map + BLANKET_CLEAR_OFFSET);
        iounmap(blanket_map);
    }
    pr_info("K3I-Core: Blanket-Überwachungsmodul erfolgreich entladen.\n");
}

module_init(k3i_blanket_init);
module_exit(k3i_blanket_exit);


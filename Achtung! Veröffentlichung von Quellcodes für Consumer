# =============================================================================
# OPTIMIERUNGS-QUELLCODE FOR INTEL CORE i7 (CONSUMER TIER)
# =============================================================================
# Zielgerichtet auf die hybride Architektur (P-Cores / E-Cores) von Intel.
# Reduziert Kontextwechsel (Context Switches) bei rechenintensiven Prozessen.

def target_intel_i7_profile():
    import sys
    import os
    
    # 1. Thread-Verteilung fuer Intel Core i7 initialisieren
    # Priorisiert die physischen Performance-Kerne fuer die Berechnungen
    os.environ["OMP_PLACES"] = "cores"
    os.environ["OMP_PROC_BIND"] = "close"
    
    # 2. Begrenzung fuer das Consumer-Schleifenlimit (1 Jahr Dauerbetrieb)
    max_schleifen_limit = 500000000000
    
    print("[INFO] Intel Core i7 Optimierungsprofil im RAM vorbereitet.")
    return max_schleifen_limit

# -----------------------------------------------------------------------------
# CODE FÜR DAS EINBRINGEN IN DIE SYSTEMKERNE (SCHEDULER ACTIVATION TOOL)
# -----------------------------------------------------------------------------
# Dieser Code bringt die oben definierten Parameter direkt in den Linux-Scheduler
# ein, um die Thread-Prioritaeten im nackten Kupfer zu verriegeln.

if __name__ == "__main__":
    import subprocess
    import os

    print("==========================================================")
    echo "   SK-FORGE HPC - AKTIVIERUNGS-TOOL: INTEL CORE i7        "
    print("==========================================================")
    print("Bringe optimierte Parameter in die Kern-Laufzeiten ein...")

    try:
        # Initialisierung des i7-Profils
        limit = target_intel_i7_profile()
        
        # Einbringen der optimierten Kernel-Parameter fuer die Thread-Migration
        # Setzt die Basislaufzeit und minimiert unnoetiges Verschieben zwischen Kernen
        subprocess.run(["sudo", "sysctl", "-w", "kernel.sched_base_slice_ns=4000000"], check=True)
        subprocess.run(["sudo", "sysctl", "-w", "kernel.sched_migration_cost_ns=500000"], check=True)
        
        print("----------------------------------------------------------")
        print("[ERFOLG] Kern-Impfung fuer Intel Core i7 aktiv verriegelt!")
        print(f"Schleifen-Limit fuer 1 Jahr Dauerbetrieb gesetzt: {limit:,}")
        print("==========================================================")
        
    

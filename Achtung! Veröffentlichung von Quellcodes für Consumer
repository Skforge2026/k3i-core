# =============================================================================
# OPTIMIERUNGS-QUELLCODE FÜR AMD RYZEN 9 7950X (CONSUMER TIER)
# =============================================================================
# Spezifisch angepasst an die Multi-CCD-Architektur des AMD Ryzen 9 7950X.
# Minimiert die CCD-übergreifende Thread-Migration für maximalen L3-Cache-Durchsatz.

def target_amd_7950x_profile():
    import sys
    import os
    
    # 1. Thread-Verteilung für AMD Ryzen 9 7950X initialisieren
    # Bindet Threads eng an die jeweiligen physischen Kerne des primären CCDs
    os.environ["OMP_PLACES"] = "cores"
    os.environ["OMP_PROC_BIND"] = "close"
    
    # 2. Begrenzung für das Consumer-Schleifenlimit (1 Jahr Dauerbetrieb)
    max_schleifen_limit = 500000000000
    
    print("[INFO] AMD Ryzen 9 7950X Optimierungsprofil im RAM vorbereitet.")
    return max_schleifen_limit

# -----------------------------------------------------------------------------
# CODE FÜR DAS EINBRINGEN IN DIE SYSTEMKERNE (SCHEDULER ACTIVATION TOOL)
# -----------------------------------------------------------------------------
# Dieser Code bringt die oben definierten Parameter direkt in den Linux-Scheduler
# ein, um die Thread-Prioritäten im nackten Kupfer zu verriegeln.

if __name__ == "__main__":
    import subprocess
    import os

    print("==========================================================")
    print("   SK-FORGE HPC - AKTIVIERUNGS-TOOL: AMD RYZEN 9 7950X    ")
    print("==========================================================")
    print("Bringe optimierte Parameter in die Kern-Laufzeiten ein...")

    # Initialisierung des AMD-Profils
    limit = target_amd_7950x_profile()
    
    # Einbringen der optimierten Kernel-Parameter in den EEVDF-Scheduler
    # Maximiert die Rechenzeit pro Kern-Slice im nackten System
    subprocess.run(["sudo", "sysctl", "-w", "kernel.sched_base_slice_ns=4000000"], check=True)
    subprocess.run(["sudo", "sysctl", "-w", "kernel.sched_migration_cost_ns=500000"], check=True)
    
    print("----------------------------------------------------------")
    print("[ERFOLG] Kern-Impfung für AMD Ryzen 9 7950X aktiv verriegelt!")
    print(f"Schleifen-Limit für 1 Jahr Dauerbetrieb gesetzt: {limit:,}")
    print("==========================================================")


## 5. Implementierter Quellcode (Echtzeit-Skripte)

### A. Wächter- & Speicherbereinigungs-System (`waechter.jl`)
```julia
function check_system_limits()
    if (Sys.total_memory() - Sys.free_memory()) > 110*1024*1024*1024
        println("[NOTBREMSE] RAM-Limit von 110 GB erreicht! Herunterfahren..."); exit(1)
    end
    
    # Integrierter RAM-Blitzschutz nach jedem Einzelschritt
    GC.gc()

    c_temp = try parse(Float64, read("/sys/class/hwmon/hwmon5/temp1_input", String))/1000.0 catch try parse(Float64, read("/sys/class/hwmon/hwmon4/temp1_input", String))/1000.0 catch 0.0 end end
    if c_temp >= 75.0
        println("[NOTBREMSE] CPU-Temperatur bei " * string(c_temp) * "°C! Herunterfahren..."); exit(1)
    end
    
    g_temp = try parse(Float64, strip(read(pipeline(`nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits`), String))) catch 0.0 end
    if g_temp >= 75.0
        println("[NOTBREMSE] GPU-Temperatur bei " * string(g_temp) * "°C! Herunterfahren..."); exit(1)
    end
    
    for i in 0:3
        r_temp = try parse(Float64, read("/sys/class/hwmon/" * string(i) * "/temp1_input", String))/1000.0 catch 0.0 end
        if r_temp >= 75.0
            println("[NOTBREMSE] RAM-Sensor " * string(i) * " bei " * string(r_temp) * "°C! Herunterfahren..."); exit(1)
        end
    end
    
    for hw in ["hwmon6", "hwmon7", "hwmon8"]
        s_temp = try parse(Float64, read("/sys/class/hwmon/" * hw * "/temp1_input", String))/1000.0 catch 0.0 end
        if s_temp >= 75.0
            println("[NOTBREMSE] SSD-" * hw * " bei " * string(s_temp) * "°C! Herunterfahren..."); exit(1)
        end
    end
end
```

### B. Dreifach verschachtelte Fusions-Zündmatrix (`fusions_matrix.jl`)
```julia
function start_fusions_zündung_stufe13()
    println("=== INITIATION: ULTIMATIVE FUSIONS-ZÜNDUNG STUFE 13 ===")
    partikel_anzahl = 50000000
    pos = rand(partikel_anzahl, 3)
    fusions_ergebnisse = Float64[]
    
    for schritt in 1:10
        pos = pos .+ (exp.(-pos) .* sin.(pos .* 3.14) .* 0.05)
        pos[:, 1] = pos[:, 1] .+ (randn(partikel_anzahl) .* 0.001)
        pos = clamp.(pos, -10.0, 10.0)
        
        fusions_energie = round(sum(pos[:, 1] .* pos[:, 2] .* pos[:, 3]), digits=2)
        println("[STATUS] Schritt \$schritt beendet. Fusions-Nettoenergie: ", fusions_energie)
        push!(fusions_ergebnisse, fusions_energie)
        
        GC.gc() # Blitzschutz aktivieren
        sleep(10.0)
    end
    
    open("/mnt/lexar/julia_telemetrie/projekt1_finale_synthese_stufe13.dat", "w") do io
        writedlm(io, fusions_ergebnisse)
    end
end
```


import sys, os, gi
gi.require_version("Gtk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gtk, WebKit2, Gdk, GLib

sys.path.insert(0, "/media/cloud/Elite/Gemini_Hoffmann_Projekt")
import k3i_control, k3i_logins, k3i_downloads, k3i_kacheln

AKTIVE_FENSTER = []

class GeminiBrowser(Gtk.Window):
    def __init__(self, start_url=None):
        super().__init__(title="K3I Hoffmann & Gemini Cyber-Interface")
        self.set_default_size(1400, 850)
        cfg = k3i_control.lade_k3i_daten()
        self.startseite = start_url if start_url else cfg.get("startseite", "https://google.com")
        if not start_url and self.startseite == "about:blank": self.startseite = "https://google.com"

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0); self.add(vbox)
        self.ram_bar = Gtk.Label()
        css = Gtk.CssProvider(); css_code = "label { background-color: #000000; color: #00ff00; font-weight: bold; font-family: monospace; font-size: 14px; padding: 6px 0px; border-bottom: 2px solid #00ff00; }"
        css.load_from_data(css_code.encode()); self.ram_bar.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        ram_box = Gtk.EventBox(); ram_box.add(self.ram_bar); ram_box.connect("button-press-event", self.on_ram_bar_clicked); vbox.pack_start(ram_box, False, False, 0)

        self.k3i_dl_status = "[📥 IDLE]"

        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5, margin=5); vbox.pack_start(toolbar, False, False, 0)
        for l, f in [("◀", lambda w: self.hole_b().go_back() if self.hole_b() else None), ("▶", lambda w: self.hole_b().go_forward() if self.hole_b() else None), ("➕ NEU", lambda w: GLib.idle_add(self.neuer_tab, "about:blank")), ("➕ CLONE", lambda w: GeminiBrowser(start_url="about:blank").show_all()), ("📜 HIST", self.on_hist_button_clicked)]:
            b = Gtk.Button(label=l); b.connect("clicked", f); toolbar.pack_start(b, False, False, 0)

        self.url_entry = Gtk.Entry(); self.url_entry.connect("activate", self.on_url_activate); toolbar.pack_start(self.url_entry, True, True, 0)
        self.notebook = Gtk.Notebook(); self.notebook.set_scrollable(True); self.notebook.connect("switch-page", self.on_tab_switched); vbox.pack_start(self.notebook, True, True, 0)

        self.neuer_tab(self.startseite); self.connect("key-press-event", self.on_key_press); self.connect("destroy", self.on_window_destroy)
        GLib.timeout_add(1000, self.aktualisiere_speicher_balken); AKTIVE_FENSTER.append(self); self.show_all()

    def neuer_tab(self, url):
        vbox_tab = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        wv = WebKit2.WebView(); wv.get_settings().set_user_agent("K3i_Ki_Agent"); wv.connect("load-changed", self.on_load_changed)

        wv.get_user_content_manager().register_script_message_handler("k3i_autonom_download")
        wv.get_user_content_manager().connect("script-message-received::k3i_autonom_download", self.on_autonom_download_triggered)

        vbox_tab.pack_start(wv, True, True, 0)
        l_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5); lbl_title = Gtk.Label(label="K3I-Tab"); l_box.pack_start(lbl_title, True, True, 0)
        btn_close = Gtk.Button(label="×"); btn_close.set_relief(Gtk.ReliefStyle.NONE); btn_close.connect("clicked", lambda w, p=vbox_tab: self.tab_schliessen(p)); l_box.pack_end(btn_close, False, False, 0)
        l_box.show_all(); vbox_tab.show_all(); self.notebook.append_page(vbox_tab, l_box)
        self.notebook.set_current_page(self.notebook.get_n_pages() - 1); wv.load_uri(url)
        return False

    def on_autonom_download_triggered(self, manager, result):
        msg = result.get_js_value().to_string()
        if "||" in msg:
            url, name = msg.split("||", 1)
            k3i_downloads.starte_autonomen_download(url, name, self)

    def set_text(self, text):
        self.k3i_dl_status = text
        self.aktualisiere_speicher_balken()

    def tab_schliessen(self, p):
        idx = self.notebook.page_num(p)
        if idx != -1 and self.notebook.get_n_pages() > 1: self.notebook.remove_page(idx)

    def hole_b(self):
        idx = self.notebook.get_current_page()
        if idx != -1:
            for c in self.notebook.get_nth_page(idx).get_children():
                if isinstance(c, WebKit2.WebView): return c
        return None

    def on_url_activate(self, entry):
        u = entry.get_text().strip()
        if not (u.startswith("http://") or u.startswith("https://") or u.startswith("about:")): u = "https://" + u
        if self.hole_b(): self.hole_b().load_uri(u)

    def on_tab_switched(self, nb, p, p_num):
        for c in p.get_children():
            if isinstance(c, WebKit2.WebView):
                u = c.get_uri()
                if u == "about:blank": self.url_entry.set_text(""); self.url_entry.grab_focus()
                elif u: self.url_entry.set_text(u)

    def on_load_changed(self, wv, ev):
        u = wv.get_uri()
        if ev == WebKit2.LoadEvent.FINISHED and u:
            idx = self.notebook.page_num(wv.get_parent())
            if idx == self.notebook.get_current_page():
                if u == "about:blank": self.url_entry.set_text(""); self.url_entry.grab_focus()
                else: self.url_entry.set_text(u)

            js_sonde = """
            (function() {
                document.addEventListener('auxclick', function(e) {
                    if (e.button === 1) {
                        var target = e.target.closest('a');
                        if (target && target.href) {
                            e.preventDefault(); e.stopPropagation();
                            var url = target.href;
                            var name = url.split('/').pop().split('?') || 'k3i_datei';
                            window.webkit.messageHandlers.k3i_autonom_download.postMessage(url + '||' + name);
                        }
                    }
                }, true);
            })();
            """
            wv.run_javascript(js_sonde, None, None, None)

            cfg = k3i_control.lade_k3i_daten(); p_dict = cfg.get("passwörter", {})
            url_teile = u.replace("https://", "").replace("http://", "").split("/")
            dom_cur = url_teile[0] if url_teile else ""
            if isinstance(dom_cur, str) and dom_cur.startswith("www."): dom_cur = dom_cur[4:]
            for d, data in p_dict.items():
                if isinstance(data, dict) and (d in dom_cur or dom_cur in d):
                    js = "(function() { var ins = document.getElementsByTagName('input'); for(var i=0; i<ins.length; i++) { var n = ins[i]; if(n.type === 'text' || n.type === 'email' || n.name.indexOf('user') !== -1) n.value = '" + data.get('user', '') + "'; if(n.type === 'password' || n.name.indexOf('pass') !== -1) n.value = '" + data.get('pwd', '') + "'; } })();"
                    wv.run_javascript(js, None, None, None); break
            if not u.startswith("about:"):
                v = cfg.get("verlauf", []); v = [x for x in v if x != u]; v.insert(0, u); cfg["verlauf"] = v[:10]; k3i_control.speichere_k3i_daten(cfg)

    def aktualisiere_speicher_balken(self):
        c_limit = k3i_control.hole_aktuelles_cache_limit()
        live_ram_mb = 65
        cfg = k3i_control.lade_k3i_daten()
        w_status = "🛡️ WÄCHTER: AKTIV" if cfg.get("waechter_aktiv", True) else "🔓 OFFEN"
        self.ram_bar.set_text(f"K3I BROWSER LIVE RAM: {live_ram_mb} MB | [TOTAL CACHE LIMIT: {c_limit} MB] | {w_status} | {self.k3i_dl_status}")
        return True

    def on_ram_bar_clicked(self, w, ev):
        if ev.button == 3:
            dialog = Gtk.Dialog(title="K3I CONFIG & SECURE LOGIN PHALANX", parent=self, flags=0)
            dialog.set_default_size(600, 700)
            box = dialog.get_content_area()
            panel = k3i_kacheln.K3IKachelPanel(self)
            box.pack_start(panel, True, True, 10)
            dialog.show_all()
            dialog.run()
            dialog.destroy()
            return True
        return False

    def on_hist_button_clicked(self, w):
        v = k3i_control.lade_k3i_daten().get("verlauf", [])

    def on_key_press(self, w, ev):
        t, cur = self.notebook.get_n_pages(), self.notebook.get_current_page()
        if not self.url_entry.has_focus() and t > 0:
            if ev.keyval == Gdk.KEY_Left: self.notebook.set_current_page((cur - 1) % t); return True
            if ev.keyval == Gdk.KEY_Right: self.notebook.set_current_page((cur + 1) % t); return True
        if ev.state & Gdk.ModifierType.CONTROL_MASK and ev.keyval in [Gdk.KEY_e, Gdk.KEY_E]:
            GLib.idle_add(k3i_logins.zeige_k3i_config_panel, self); return True
        return False

    def on_window_destroy(self, w):
        if self in AKTIVE_FENSTER: AKTIVE_FENSTER.remove(self)
        if len(AKTIVE_FENSTER) == 0: Gtk.main_quit()

if __name__ == "__main__":
    Gtk.init(None)
    browser = GeminiBrowser()
    Gtk.main()
